/* 页面样式 */
.container {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 60rpx;
  color: #333;
}

.openid-section {
  width: 100%;
  background: #f5f5f5;
  padding: 30rpx;
  border-radius: 10rpx;
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.openid {
  display: block;
  font-size: 24rpx;
  color: #07c160;
  word-break: break-all;
  font-family: monospace;
}

.btn {
  width: 80%;
  margin: 20rpx 0;
  background: #07c160;
  color: white;
  border-radius: 10rpx;
}

.tips {
  margin-top: 60rpx;
  width: 100%;
  padding: 20rpx;
  background: #fff9e6;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
}

.tips-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #e6a23c;
  margin-bottom: 10rpx;
}

.tips text {
  font-size: 24rpx;
  color: #666;
  line-height: 40rpx;
}
